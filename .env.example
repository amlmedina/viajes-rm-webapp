# =====================================================================
# INDIPRIS ERP / VIAJES RM - VARIABLES DE ENTORNO
# Copia estas variables a tu proyecto en Vercel:
# Dashboard Vercel > Project > Settings > Environment Variables
# =====================================================================

# 1. GOOGLE CLOUD SERVICE ACCOUNT (Credenciales JSON de cuenta de servicio)
# Pega aquí el JSON completo de la clave de servicio en una sola línea o tal cual.
# Debe tener permisos de Editor en el Google Sheet y en la carpeta de Drive.
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# 2. GOOGLE SHEETS (IDs de las hojas de cálculo)
# ID del Google Spreadsheet principal donde residen Solicitudes, Usuarios, etc.
# Lo obtienes de la URL: https://docs.google.com/spreadsheets/d/[ESTE_ID]/edit
SPREADSHEET_ID="tu_spreadsheet_id_aqui"

# ID de la hoja de Empresas (opcional, si es la misma hoja déjalo igual a SPREADSHEET_ID)
COMPANIES_SS_ID="tu_spreadsheet_id_aqui"

# ID de la carpeta de Google Drive para comprobantes y vouchers
DRIVE_FOLDER_ID="1SalfWTHMSUVHuaemuyCdY2iUsqAsq4Q2"

# ID del Google Sheet Legacy / Orbix (para exportación de viajes y reservas)
LEGACY_SS_ID="19M9mCVrYBzCYDQlIz-tiDks-sXcOc4F8wucjAMPZeeQ"

# 3. NOTIFICACIONES WHATSAPP (textmebot.com)
# API Key generada por textmebot.com
WHATSAPP_API_KEY=""

# 4. SEGURIDAD Y SESIÓN
# Cadena secreta aleatoria para firma de tokens JWT
JWT_SECRET="indipris_secret_token_change_in_production"

# 5. INTEGRACIONES EXTERNAS (Opcional)
# URL del middleware de sincronización con CRM externo
MIDDLEWARE_API_URL="https://indipristi.taila4be24.ts.net"
